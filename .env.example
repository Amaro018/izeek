# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Database ---
# Local dev (MariaDB on host port 3307):
#   DATABASE_URL="mysql://root:PASSWORD@localhost:3307/izeek_db"
# In Docker / Portainer (MariaDB container named "mariadb" on cloudflare_net):
#   DATABASE_URL="mysql://root:PASSWORD@mariadb/izeek_db"
# URL-encode special chars in the password (@ -> %40, # -> %23).
DATABASE_URL="mysql://root:PASSWORD@mariadb/izeek_db"

# --- App ---
# Public origin — used for password-reset links and uploaded image URLs.
APP_ORIGIN="https://izeek.jhomariamaro.online"
BASE_URL="https://izeek.jhomariamaro.online"

# Blitz session secret. REQUIRED in production. Generate: openssl rand -hex 32
SESSION_SECRET_KEY="generate_a_random_32char_min_secret"
